# Where uploaded images are stored
DATA_DIR=data

# PostgreSQL. For a local database started with `docker compose up -d db`,
# the defaults from compose.yaml work: alumap/alumap on localhost:5432.
DATABASE_URL=postgres://alumap:alumap@localhost:5432/alumap
# Used by docker compose to create the database; change the password in production.
POSTGRES_USER=alumap
POSTGRES_PASSWORD=alumap
POSTGRES_DB=alumap

# adapter-node assumes https. For plain http (local run without a proxy) set:
# PROTOCOL_HEADER=x-forwarded-proto  (and make the proxy send it)
# Max upload size (images)
BODY_SIZE_LIMIT=16M

# SMTP for verification codes. If SMTP_HOST is empty, codes are printed to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Alumap <noreply@example.com>"

# Telegram bot (optional). The "Open Alumap" button opens MINIAPP_URL, the public https URL of the site.
BOT_TOKEN=
MINIAPP_URL=https://alumap.example.com
