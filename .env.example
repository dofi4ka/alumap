# Where sqlite db and uploaded images are stored
DATA_DIR=data
# adapter-node assumes https. For plain http (local run without a proxy) set:
# PROTOCOL_HEADER=x-forwarded-proto  (and make the proxy send it)
# Max upload size (images)
BODY_SIZE_LIMIT=16M

# SMTP for verification codes. If SMTP_HOST is empty, codes are printed to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Alumap <noreply@example.com>"

# Telegram bot (optional). The "Open Alumap" button opens MINIAPP_URL, the public https URL of the site.
BOT_TOKEN=
MINIAPP_URL=https://alumap.example.com
